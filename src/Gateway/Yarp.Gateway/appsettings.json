{
  "Urls": "http://127.0.0.1:5181",
  "ReverseProxy": {
    "Routes": {
      "hr": {
        "ClusterId": "hr",
        "Match": {
          "Path": "/api/HumanResource/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/HumanResource"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "lookups": {
        "ClusterId": "hr",
        "Match": {
          "Path": "/api/Lookups/{**rest}"
        }
      },
      "lov": {
        "ClusterId": "hr",
        "Match": {
          "Path": "/api/Lov/{**rest}"
        }
      },
      "dashboard": {
        "ClusterId": "hr",
        "Match": {
          "Path": "/api/auth/HR/{**rest}"
        }
      },
      "organization": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/organization/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/organization"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "auth": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "support": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/{**rest}"
        },
        "Order": 100
      },
      "workflow": {
        "ClusterId": "workflow",
        "Match": {
          "Path": "/api/Workflow/{**rest}"
        }
      },
      "academicReferences": {
        "ClusterId": "hr",
        "Match": {
          "Path": "/api/Academics/{**rest}"
        }
      }
    },
    "Clusters": {
      "hr": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5182"
          }
        }
      },
      "organization": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5183"
          }
        }
      },
      "workflow": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5184"
          }
        }
      }
    }
  }
}
