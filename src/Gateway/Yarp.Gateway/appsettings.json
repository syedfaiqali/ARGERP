{
  "Urls": "http://127.0.0.1:5181",
  "ReverseProxy": {
    "Routes": {
      "hr": {
        "ClusterId": "hr",
        "Match": {
          "Path": "/api/HumanResource/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/HumanResource"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "organization": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/organization/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/organization"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "auth": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "users": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/arg/users/{**rest}"
        }
      }
    },
    "Clusters": {
      "hr": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5182"
          }
        }
      },
      "organization": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5183"
          }
        }
      }
    }
  }
}